        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class ISprzedaz {\n        &lt;&lt;interface&gt;&gt;\n        +String Kod\n        +Double Cena\n        +String Nazwa\n        +WyswietlSzczegoly() void\n    }\n\n    class EKategoria {\n        Przekaska\n        Napoj\n        Slodycz\n    }\n\n    class Produkt {\n        &lt;&lt;abstract&gt;&gt;\n        -String _nazwa\n        -Double _cena\n        #String _kod\n        +String Nazwa\n        +Double Cena\n        +String Kod\n        +Kategoria Kategoria\n        +Produkt(nazwa, cena, kod, kategoria)\n        +Produkt(nazwa, cena, kategoria)\n        +WyswietlSzczegoly() void\n    }\n\n    class Napoj {\n        +Int PojemnoscMl\n        +Napoj(nazwa, cena, kod, pojemnoscMl)\n        +Napoj(nazwa, cena, pojemnoscMl)\n        +WyswietlSzczegoly() void\n    }\n\n    class Przekaska {\n        +Double wagaGramy\n        +Przekaska(nazwa, cena, kod, wagaGramy)\n        +WyswietlSzczegoly() void\n    }\n\n    class Slodycz {\n        +Boolean czyZawieraOrzechy\n        +Slodycz(nazwa, cena, kod, czyZawieraOrzechy)\n        +Slodycz(nazwa, cena, czyZawieraOrzechy)\n        +WyswietlSzczegoly() void\n    }\n\n    class Automat {\n        -List~ISprzedaz~ asortyment\n        +DodajProdukt(produkt ISprzedaz) void\n        +WyswietlKatalog() void\n        +KupProdukt(kod String, wrzuconePieniadze Double) void\n    }\n\n    ISprzedaz &lt;|.. Produkt : Implements\n    Produkt &lt;|-- Napoj : Inherits\n    Produkt &lt;|-- Przekaska : Inherits\n    Produkt &lt;|-- Slodycz : Inherits\n    Produkt --&gt; KategoriaProduktu : Uses\n    Automat --&gt; ISprzedawalny : Aggregates / Contains&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="zk2J32vWiCQrU2b6bR_s-54">
